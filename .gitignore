# ---------------------------------------------------------------- generated
data/output/
data/intermediate/

# The viewer's data products ARE committed - they are what GitHub Pages serves,
# and regenerating them needs the multi-GB LiDAR block that is not in this repo.
# The five shadow scales come to ~106 MB. The orthophoto tile set does not:
# it was 671 MB, so the viewer reads the IGN WMTS instead (see package_tiles.py).
viewer/public/data/tiles/rgb/

# 3D terrain (package_tiles.py --with-terrain). Local experiment only. The metadata
# lives in its own file rather than in layers.json precisely so that the committed
# layers.json cannot advertise terrain tiles that the deployed site does not have.
viewer/public/data/tiles/terrain/
viewer/public/data/terrain.json

viewer/dist/

